{
  "name": "hysterical-panel-frontend",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./.output/server/index.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm i18n:check",
    "prepare": "cd .. && husky",
    "api:schema": "../scripts/generate-openapi-schema.sh",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "api:sync": "pnpm api:schema && pnpm api:types"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@gravity-ui/icons": "^2.19.0",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@inlang/paraglide-js": "^2.20.2",
    "@internationalized/date": "^3.12.2",
    "@react-aria/i18n": "^3.13.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/react-table": "^8.21.3",
    "cnfast": "^0.0.6",
    "nitro": "3.0.260522-beta",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,jsonc}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.33.0"
}
